# ---- Supabase ----
# Public values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL="https://mrgpvrxwgqtikqyuratq.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_35WEshtz5Ixos5Ushzc3mw_sOiB9HVS"
# SECRET: server only. Never put in client code or chat.
# Supabase > Project Settings > API keys > secret key
SUPABASE_SECRET_KEY=""
# Supabase > Project Settings > Database > Connection string. Replace [YOUR-PASSWORD] and REGION.
# Pooled (Transaction mode, port 6543):
DATABASE_URL="postgresql://postgres.mrgpvrxwgqtikqyuratq:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session (port 5432), used by prisma migrate:
DIRECT_URL="postgresql://postgres.mrgpvrxwgqtikqyuratq:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Required (all modes) ----
APP_URL="http://localhost:3000"
SESSION_SECRET="generate-with: openssl rand -hex 32"

# ---- Mode ----
# "demo": uses a clearly labelled internal test ledger. Nothing here can be withdrawn.
# "production": requires every provider credential below before the related feature turns on.
APP_MODE="demo"

# ---- Requires external credentials (features stay disabled until set) ----
# CAPTCHA (hCaptcha or Cloudflare Turnstile)
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# Email (verification + password reset), e.g. SMTP or Resend
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FaucetFlow <no-reply@example.com>"

# Google login (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Crypto payout provider (e.g. FaucetPay). Withdrawals are never marked
# COMPLETED unless this provider confirms the payout.
PAYOUT_PROVIDER_API_KEY=""

# Offerwall / shortlink providers: postback signing secrets
OFFERWALL_POSTBACK_SECRET=""
SHORTLINK_API_KEY=""
